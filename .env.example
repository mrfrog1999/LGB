# 端口（宿主机映射到容器的 8080）
PORT=8080

# 数据库存放目录（容器内路径，配合 compose 的 volume）
DB_PATH=/data/finance.db

# 会话签名密钥：务必改成一串随机字符（可用 openssl rand -hex 32 生成）
SESSION_SECRET=please-change-this-to-a-long-random-string

# 首次启动时自动创建的账号（密码可登录后在「我的」页修改）
BOOTSTRAP_USER=admin
BOOTSTRAP_PASSWORD=admin12345

# 可选：SMTP 邮件通知（不填则只用 Webhook）
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_TO=
