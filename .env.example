# ============ 首次启动默认订阅的产品 ============
# 建信宝按日开放式产品第4期（代销建信理财）
BOOTSTRAP_CODE=JXJXBGS2023060204
BOOTSTRAP_NAME=建信宝按日开放式产品第4期（代销建信理财)
# 网页搜索框的默认关键词（同一系列的所有期次都能搜到）
SEARCH_KEYWORD=建信宝按日开放式

# 首次启动给新产品预填的本金，可在网页里随时改
DEFAULT_PRINCIPAL=100000
# 预填的买入日期（留空则用该产品最早可获得的数据日）
DEFAULT_START_DATE=

# ============ 抓取 ============
# 每天几点抓取并推送，24 小时制，服务器时区由 TZ 决定
FETCH_TIME=09:10
# 容器首次启动、库里没数据时，是否立刻抓一次
FETCH_ON_START=true
# 单次 HTTP 超时（秒）与重试次数
HTTP_TIMEOUT=30
FETCH_RETRIES=3

# ============ 邮件 ============
MAIL_ENABLED=true
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
# 465 端口用 SSL 填 true；587 端口 STARTTLS 填 false
SMTP_SSL=true
# 发件邮箱账号（通常就是完整邮箱地址）
SMTP_USER=your@qq.com
# 邮箱授权码（不是登录密码！QQ 邮箱在“设置-账户”里开启 SMTP 后获取）
SMTP_PASS=
# 发件人地址，留空则用 SMTP_USER
MAIL_FROM=
# 收件邮箱，多个用逗号分隔
MAIL_TO=your@qq.com
# 邮件标题前缀
MAIL_SUBJECT_PREFIX=建行理财收益日报

# ============ 存储 ============
DB_PATH=/data/data.db
